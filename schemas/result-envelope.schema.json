{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-agent-research:schema:result-envelope:1.0",
  "title": "Local Loop Result Envelope",
  "description": "Schema-validated worker result. Acceptance remains a controller/verifier decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "envelope_type",
    "run_id",
    "task_id",
    "task_version",
    "attempt_id",
    "acknowledged_task_envelope_sha256",
    "status",
    "summary",
    "artifacts",
    "claims",
    "evidence",
    "tool_receipt_ids",
    "checks_run_by_worker",
    "changed_scope",
    "unresolved",
    "proposed_followups",
    "usage",
    "failure"
  ],
  "properties": {
    "protocol_version": {
      "const": "local-loop/1.0"
    },
    "envelope_type": {
      "const": "result"
    },
    "run_id": {
      "$ref": "#/$defs/runId"
    },
    "task_id": {
      "$ref": "#/$defs/taskId"
    },
    "task_version": {
      "type": "integer",
      "minimum": 1
    },
    "attempt_id": {
      "$ref": "#/$defs/attemptId"
    },
    "acknowledged_task_envelope_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "tool_receipt_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/receiptId"
      },
      "uniqueItems": true
    },
    "checks_run_by_worker": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workerCheck"
      }
    },
    "changed_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "uniqueItems": true
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "uniqueItems": true
    },
    "proposed_followups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposedFollowup"
      }
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "failure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "failure": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "failure": {
            "$ref": "#/$defs/failure"
          }
        }
      }
    }
  ],
  "$defs": {
    "runId": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^task_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^attempt_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^artifact_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "claimId": {
      "type": "string",
      "pattern": "^claim_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^evidence_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^receipt_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "uri",
        "sha256",
        "media_type",
        "bytes"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/artifactId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "plan",
            "source_snapshot",
            "note",
            "patch",
            "file",
            "report",
            "test_log",
            "trace",
            "model_output"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement",
        "confidence",
        "evidence_ids"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/claimId"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceId"
          },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_artifact_id",
        "source_url",
        "locator",
        "support"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/evidenceId"
        },
        "source_artifact_id": {
          "$ref": "#/$defs/artifactId"
        },
        "source_url": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uri",
              "maxLength": 4096
            }
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "support": {
          "type": "string",
          "enum": [
            "supports",
            "contradicts",
            "contextual"
          ]
        }
      }
    },
    "workerCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "receipt_id"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "receipt_id": {
          "$ref": "#/$defs/receiptId"
        }
      }
    },
    "proposedFollowup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "reason"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "tool_calls",
        "wall_seconds"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "wall_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "message",
        "failure_signature",
        "retryable",
        "recommended_change",
        "partial_effect_receipt_ids"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "transient_runtime",
            "schema",
            "tool_protocol",
            "capability",
            "semantic",
            "verifier",
            "policy",
            "interrupted"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "failure_signature": {
          "$ref": "#/$defs/sha256"
        },
        "retryable": {
          "type": "boolean"
        },
        "recommended_change": {
          "type": "string",
          "enum": [
            "model",
            "prompt",
            "context",
            "tool",
            "plan",
            "none"
          ]
        },
        "partial_effect_receipt_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/receiptId"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
