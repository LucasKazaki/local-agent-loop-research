{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local-agent-research:schema:routing-manifest:1.0",
  "title": "Local Loop Routing Manifest",
  "description": "Versioned, benchmark-derived mapping from logical roles to eligible local model/runtime candidates. This schema contains no model winner or default.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "protocol_version",
    "manifest_id",
    "status",
    "generated_at",
    "benchmark_snapshot_id",
    "hardware_profile_id",
    "profiles"
  ],
  "properties": {
    "manifest_version": {
      "const": "routing-manifest/1.0"
    },
    "protocol_version": {
      "const": "local-loop/1.0"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^routing_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "validated"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "benchmark_snapshot_id": {
      "$ref": "#/$defs/benchmarkSnapshotId"
    },
    "hardware_profile_id": {
      "type": "string",
      "pattern": "^hardware_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/routingProfile"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "validated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "profiles": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/routingProfile"
                },
                {
                  "properties": {
                    "eligible_models": {
                      "minItems": 1
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "benchmarkSnapshotId": {
      "type": "string",
      "pattern": "^bench_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^artifact_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "role": {
      "type": "string",
      "enum": [
        "planner",
        "researcher",
        "coder",
        "extractor",
        "vision",
        "verifier",
        "critic",
        "synthesizer",
        "policy_guard"
      ]
    },
    "taskFamily": {
      "type": "string",
      "enum": [
        "research",
        "code_read",
        "code_write",
        "extraction",
        "reasoning",
        "vision",
        "action",
        "mixed"
      ]
    },
    "metricName": {
      "type": "string",
      "enum": [
        "role_score",
        "task_success_rate",
        "tool_semantic_success",
        "schema_success",
        "citation_precision",
        "regression_rate",
        "median_seconds",
        "peak_vram_mib",
        "peak_ram_mib"
      ]
    },
    "routingProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "description",
        "roles",
        "task_families",
        "required_capabilities",
        "minimum_thresholds",
        "selection_policy",
        "eligible_models",
        "fallback_profile_id"
      ],
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/profileId"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/role"
          },
          "uniqueItems": true
        },
        "task_families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/taskFamily"
          },
          "uniqueItems": true
        },
        "required_capabilities": {
          "$ref": "#/$defs/requiredCapabilities"
        },
        "minimum_thresholds": {
          "$ref": "#/$defs/minimumThresholds"
        },
        "selection_policy": {
          "$ref": "#/$defs/selectionPolicy"
        },
        "eligible_models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/eligibleModel"
          }
        },
        "fallback_profile_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/profileId"
            }
          ]
        }
      }
    },
    "requiredCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_calling",
        "schema_output",
        "vision",
        "reasoning_state",
        "minimum_context_tokens"
      ],
      "properties": {
        "tool_calling": {
          "type": "boolean"
        },
        "schema_output": {
          "type": "boolean"
        },
        "vision": {
          "type": "boolean"
        },
        "reasoning_state": {
          "type": "boolean"
        },
        "minimum_context_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "minimumThresholds": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "role_score": {
          "$ref": "#/$defs/unitScore"
        },
        "task_success_rate": {
          "$ref": "#/$defs/unitScore"
        },
        "tool_semantic_success": {
          "$ref": "#/$defs/unitScore"
        },
        "schema_success": {
          "$ref": "#/$defs/unitScore"
        },
        "citation_precision": {
          "$ref": "#/$defs/unitScore"
        },
        "maximum_regression_rate": {
          "$ref": "#/$defs/unitScore"
        },
        "maximum_median_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximum_peak_vram_mib": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_peak_ram_mib": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "selectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_by",
        "tie_breakers"
      ],
      "properties": {
        "order_by": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/metricOrdering"
          }
        },
        "tie_breakers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metricOrdering"
          }
        }
      }
    },
    "metricOrdering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "direction"
      ],
      "properties": {
        "metric": {
          "$ref": "#/$defs/metricName"
        },
        "direction": {
          "type": "string",
          "enum": [
            "higher",
            "lower"
          ]
        }
      }
    },
    "eligibleModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_family",
        "model_artifact_sha256",
        "quantization",
        "prompt_bundle_sha256",
        "template_sha256",
        "runtime",
        "runtime_settings_sha256",
        "gpu_affinity",
        "context_limit",
        "max_output_tokens",
        "capabilities",
        "measured_scores",
        "benchmark_snapshot_id",
        "measurement_artifact_id",
        "thresholds_passed"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "model_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "model_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "quantization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "prompt_bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "template_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "runtime_settings_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "gpu_affinity": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "context_limit": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "capabilities": {
          "$ref": "#/$defs/modelCapabilities"
        },
        "measured_scores": {
          "$ref": "#/$defs/measuredScores"
        },
        "benchmark_snapshot_id": {
          "$ref": "#/$defs/benchmarkSnapshotId"
        },
        "measurement_artifact_id": {
          "$ref": "#/$defs/artifactId"
        },
        "thresholds_passed": {
          "const": true
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_id",
        "kind",
        "build_id",
        "api_base"
      ],
      "properties": {
        "runtime_id": {
          "type": "string",
          "pattern": "^runtime_[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "llama_cpp",
            "ollama",
            "lm_studio",
            "other_openai_compatible"
          ]
        },
        "build_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "api_base": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "modelCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_calling",
        "schema_output",
        "vision",
        "reasoning_state"
      ],
      "properties": {
        "tool_calling": {
          "type": "boolean"
        },
        "schema_output": {
          "type": "boolean"
        },
        "vision": {
          "type": "boolean"
        },
        "reasoning_state": {
          "type": "boolean"
        }
      }
    },
    "measuredScores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_score",
        "task_success_rate",
        "tool_semantic_success",
        "schema_success",
        "citation_precision",
        "regression_rate",
        "median_seconds",
        "peak_vram_mib",
        "peak_ram_mib",
        "evaluated_tasks",
        "repetitions"
      ],
      "properties": {
        "role_score": {
          "$ref": "#/$defs/unitScore"
        },
        "task_success_rate": {
          "$ref": "#/$defs/unitScore"
        },
        "tool_semantic_success": {
          "$ref": "#/$defs/nullableUnitScore"
        },
        "schema_success": {
          "$ref": "#/$defs/unitScore"
        },
        "citation_precision": {
          "$ref": "#/$defs/nullableUnitScore"
        },
        "regression_rate": {
          "$ref": "#/$defs/nullableUnitScore"
        },
        "median_seconds": {
          "type": "number",
          "minimum": 0
        },
        "peak_vram_mib": {
          "type": "integer",
          "minimum": 0
        },
        "peak_ram_mib": {
          "type": "integer",
          "minimum": 0
        },
        "evaluated_tasks": {
          "type": "integer",
          "minimum": 1
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "unitScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nullableUnitScore": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/unitScore"
        }
      ]
    }
  }
}
