# Dependencies and generated coverage
node_modules/
coverage/
.npm/

# Local configuration and credentials
.env
.env.*
!.env.example

# Temporary process output
*.log
*.pid
*.tmp
*.temp
*.partial
logs/
temp/
tmp/
.cache/

# Notebook execution scratch space (not notebooks themselves)
**/.ipynb_checkpoints/

# Python bytecode generated by notebook support scripts
**/__pycache__/
*.py[cod]

# Editor and operating-system metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Research evidence is intentionally versioned. These negations document that
# benchmark JSON/CSV, notebooks, and rendered reports belong in the repository.
!benchmark/**/*.json
!results/**/*.json
!results/**/*.csv
!evidence/**/*.json
!evidence/**/*.csv
!evidence/**/*.ipynb
!evidence/**/*.html
!evidence/**/*.md
